# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=494a05a1badaeef89547926158b7c721afea7c33eeddcc15fb1adde89d34cbdd

# Key used to encrypt TOTP secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=ezhMHhZFMn_T9i6pZK2iNEQdIifGl4vBhsNA3nRb-Q0=

# Database connection.
# Default (recommended for this portfolio project): local SQLite file.
DATABASE_URL=sqlite:///instance/app.db
# To use Supabase/Postgres instead, use its connection string, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Flask environment. "production" disables debug mode and enables secure cookies.
FLASK_ENV=development

# Set to "true" only when serving over HTTPS (required in production).
SESSION_COOKIE_SECURE=false

# Rate limiting (requests per window, per IP). Loosen these in development if they get annoying.
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_REGISTER=5 per minute
RATE_LIMIT_MFA_VERIFY=10 per minute
RATE_LIMIT_MFA_SETUP=5 per minute
